{
    "name": "php-concept/stack",
    "description": "Concept application stack recipes",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Concept\\Stack\\": "src/"
        }
    },
    "require": {
        "php": "^8.4",
        "league/container": "^5.1",
        "monolog/monolog": "^3",
        "php-concept/core-2": "^1.0",
        "php-concept/extension-casting-valinor": "^1.0",
        "php-concept/extension-console-symfony": "^1.0",
        "php-concept/extension-data-masker": "^1.0",
        "php-concept/extension-form-request": "^1.0",
        "php-concept/extension-http": "^1.0",
        "php-concept/extension-csrf": "^1.0",
        "php-concept/extension-database-eloquent": "^1.0",
        "php-concept/extension-logger-monolog": "^1.0",
        "php-concept/extension-session-symfony": "^1.0",
        "php-concept/extension-validation-rakit": "^1.0",
        "php-concept/extension-view": "^1.0",
        "php-concept/extension-view-plates": "^1.0",
        "php-concept/extension-view-twig": "^1.0",
        "symfony/console": "^7.3",
        "symfony/http-foundation": "^7.2",
        "php-concept/extension-error-handler-whoops": "^1.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1"
    },
    "repositories": {
        "extension-logger-monolog": {
            "type": "path",
            "url": "../concept-extensions/extension-logger-monolog",
            "options": {
                "symlink": true,
                "versions": {
                    "php-concept/extension-logger-monolog": "1.0.0"
                }
            }
        },
        "extension-csrf": {
            "type": "path",
            "url": "../concept-extensions/extension-csrf",
            "options": {
                "symlink": true,
                "versions": {
                    "php-concept/extension-csrf": "1.0.0"
                }
            }
        },
        "extension-database-eloquent": {
            "type": "path",
            "url": "../concept-extensions/extension-database-eloquent",
            "options": {
                "symlink": true,
                "versions": {
                    "php-concept/extension-database-eloquent": "1.0.0"
                }
            }
        },
        "extension-session-symfony": {
            "type": "path",
            "url": "../concept-extensions/extension-session-symfony",
            "options": {
                "symlink": true,
                "versions": {
                    "php-concept/extension-session-symfony": "1.0.0"
                }
            }
        },
        "extension-view": {
            "type": "path",
            "url": "../concept-extensions/extension-view",
            "options": {
                "symlink": true,
                "versions": {
                    "php-concept/extension-view": "1.0.0"
                }
            }
        },
        "extension-view-plates": {
            "type": "path",
            "url": "../concept-extensions/extension-view-plates",
            "options": {
                "symlink": true,
                "versions": {
                    "php-concept/extension-view-plates": "1.0.0"
                }
            }
        },
        "extension-view-twig": {
            "type": "path",
            "url": "../concept-extensions/extension-view-twig",
            "options": {
                "symlink": true,
                "versions": {
                    "php-concept/extension-view-twig": "1.0.0"
                }
            }
        }
    }
}
