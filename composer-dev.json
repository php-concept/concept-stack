{
    "name": "php-concept/stack",
    "description": "Concept stack assembler (thin: ConceptStack + brick contracts)",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Concept\\Stack\\": "src/"
        }
    },
    "require": {
        "php": "^8.4",
        "league/container": "^5.1",
        "php-concept/core-2": "^1.0",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../concept-core-2",
            "options": {
                "symlink": true,
                "versions": {
                    "php-concept/core-2": "1.0.0"
                }
            }
        }
    ]
}
